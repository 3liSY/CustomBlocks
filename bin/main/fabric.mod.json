{
  "schemaVersion": 1,
  "id": "customblocks",
  "version": "2.0.0",
  "name": "CustomBlocks",
  "description": "Paint any image onto blocks — URL, GIF, per-face, color tools, categories, cloud sharing. No coding needed.",
  "authors": [ "3liSY" ],
  "license": "MIT",
  "icon": "assets/customblocks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main":   [ "com.customblocks.CustomBlocksMod" ],
    "client": [ "com.customblocks.client.CustomBlocksClient" ]
  },
  "mixins": ["customblocks.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api":   "*",
    "minecraft":    "~1.21.1",
    "java":         ">=21"
  },
  "suggests": {
    "fabric-permissions-api-v0": "*",
    "cloth-config": "*",
    "modmenu": "*"
  },
  "contact": {
    "sources": "https://github.com/3liSY/CustomBlocks"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/customblocks"
      }
    }
  }
}
